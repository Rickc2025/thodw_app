rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserData() {
      return get(currentUserPath()).data;
    }

    function currentUserExists() {
      return signedIn() && exists(currentUserPath());
    }

    function isAdmin() {
      return currentUserExists() &&
        currentUserData().role == 'admin' &&
        currentUserData().disabled != true;
    }

    function isActiveUser() {
      return currentUserExists() && currentUserData().disabled != true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function emailMatchesMelcoId(melcoId) {
      return signedIn() && request.auth.token.email == (melcoId + '@hodw.local');
    }

    function selfUserFieldsUnchanged() {
      return request.resource.data.melcoId == resource.data.melcoId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.displayName == resource.data.displayName &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.disabled == resource.data.disabled &&
        request.resource.data.bootstrapAdmin == resource.data.bootstrapAdmin &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if false;

      allow update: if isAdmin() || (
        isSelf(uid) &&
        isActiveUser() &&
        selfUserFieldsUnchanged()
      );

      allow delete: if false;
    }

    match /divers/{docId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /checkins/{docId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isActiveUser();
    }

    match /logs/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /showdeck_aqc/{docId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isActiveUser();
    }

    match /prefs/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
